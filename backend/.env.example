# Copy this file to backend/.env for local development (backend/.env is git-ignored).
# Spring Boot reads it via spring.config.import in application.properties.

DB_URL=jdbc:postgresql://localhost:5432/smartattend
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password_here

# Optional
# APP_TOKEN_SECRET=any-long-random-string     # keeps you logged in across restarts
# ADMIN_EMAIL=admin@school.edu                # first-run admin account
# ADMIN_PASSWORD=admin123
# CORS_ALLOWED_ORIGINS=*
# SHOW_SQL=true                               # print every SQL statement
