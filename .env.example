# Frontend environment variables (Vite only exposes variables that start with VITE_).
#
# Local development: .env.development (committed) already points at http://localhost:8081/api.
# Production: set VITE_API_URL in your hosting dashboard (Render / Vercel) BEFORE building,
# because Vite bakes it into the JavaScript at build time.

# URL of your deployed Spring Boot backend ("/api" is appended automatically if missing)
VITE_API_URL=https://your-backend.onrender.com/api
